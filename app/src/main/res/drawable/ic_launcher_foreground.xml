<?xml version="1.0" encoding="utf-8"?>
<!-- Map-pin glyph sized for the adaptive-icon safe zone (66dp circle in a 108dp canvas).
     The foreground must be a real drawable with intrinsic bounds: a bare @color here
     crashes the system PackageInstaller on several Android builds.
     The pin body has a round evenOdd hole (r 8.5) around the grey dot (r 6.5): the thin ring
     between them is transparent, not painted white, so the monochrome layer keeps the gap. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1361A7"
        android:fillType="evenOdd"
        android:pathData="M54,26c-10.5,0 -19,8.5 -19,19 0,14.2 19,37 19,37s19,-22.8 19,-37c0,-10.5 -8.5,-19 -19,-19z M54,53.5a8.5,8.5 0 1,1 0,-17 8.5,8.5 0 0,1 0,17z" />
    <path
        android:fillColor="#818589"
        android:pathData="M54,51.5a6.5,6.5 0 1,1 0,-13 6.5,6.5 0 0,1 0,13z" />
</vector>
